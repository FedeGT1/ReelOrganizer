# Copy to .env and fill in real values. Never commit the real .env file
# (it's already in .gitignore) -- these are only placeholder examples.

AUTH_USERNAME=your-username
AUTH_PASSWORD=your-strong-password
SESSION_SECRET_KEY=generate-with-python3-c-import-secrets-print-secrets-token_hex-32

# Default AI provider is Anthropic.
ANTHROPIC_API_KEY=sk-ant-...

# To use OpenAI instead, set AI_PROVIDER=openai and fill in OPENAI_API_KEY.
# AI_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# AI_REASONING_EFFORT=medium
# Per-call timeout (seconds) applied only to OpenAI calls that use web
# search -- those routinely take longer than the 15s baseline used for
# ordinary calls. Default 30 if unset.
# OPENAI_TIMEOUT=30
